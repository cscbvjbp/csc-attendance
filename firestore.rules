rules_version = '2';

// CSC Bal Vidyalaya - Staff Attendance
// Paste this whole file in Firebase > Firestore Database > Rules, then press Publish.
//
// To add another admin, add one more email to the list in isAdmin(),
// for example: ['admin@cscbalvidyalaya.app', 'principal@cscbalvidyalaya.app']
// and create that user in Firebase > Authentication > Users.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['admin@cscbalvidyalaya.app'];
    }

    function mapped() {
      return signedIn() && exists(/databases/$(database)/documents/uids/$(request.auth.uid));
    }

    function myId() {
      return get(/databases/$(database)/documents/uids/$(request.auth.uid)).data.staffId;
    }

    function isStaff() {
      return mapped() && get(/databases/$(database)/documents/staff/$(myId())).data.active == true;
    }

    function schoolQr() {
      return get(/databases/$(database)/documents/secret/qr).data.value;
    }

    // Staff ID -> hidden login email. Needed before sign-in, so one document can be read by anyone.
    match /loginmap/{staffId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Firebase user id -> staff ID
    match /uids/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAdmin() || (mapped() && myId() == staffId);
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }

    // The school QR value. Only the admin can read it, so staff must really scan it.
    match /secret/{docId} {
      allow read, write: if isAdmin();
    }

    match /attendance/{docId} {
      allow get: if isAdmin() || (isStaff() && (resource == null || resource.data.staffId == myId()));
      allow list: if isAdmin() || (isStaff() && resource.data.staffId == myId());

      allow create: if isStaff()
        && request.resource.data.staffId == myId()
        && docId == myId() + '_' + request.resource.data.date
        && request.resource.data.inAt == request.time
        && request.resource.data.qr == schoolQr();

      allow update: if isStaff()
        && resource.data.staffId == myId()
        && request.resource.data.staffId == myId()
        && request.resource.data.inAt == resource.data.inAt
        && request.resource.data.outAt == request.time
        && request.resource.data.qr == schoolQr();

      allow write: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow read: if isAdmin() || (isStaff() && resource.data.staffId == myId());

      allow create: if isStaff()
        && request.resource.data.staffId == myId()
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (isStaff()
            && resource.data.staffId == myId()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']));

      allow delete: if isAdmin();
    }
  }
}
